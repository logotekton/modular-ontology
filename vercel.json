{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "node_modules/{@xeokit/**,@loaders.gl/**,@math.gl/**,web-ifc/**,commander/**,pako/**,laz-perf/**,draco3d/**,ktx-parse/**,texture-compressor/**,pngjs/**,web-streams-polyfill/**}",
      "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,fixtures/**,__fixtures__/**,testdata/**,sample-data/**,docs/**,manus_harness/**,scripts/**,tools/**,google_drive_staging/**,backups/**,original file/**,dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/mcp/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
